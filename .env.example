# Optional overrides. `docker compose up --build` works with none of these set.
# Changing a port updates the Keycloak redirect URIs and the issuer automatically.
APP_PORT=8080
AUTH_PORT=8180
# The two internal networks use fixed subnets (the API trusts X-Forwarded-* only from the app one; the Vault AppRoles
# are bound to the data one). Override if they clash with a VPN or another Docker network.
APP_SUBNET=10.231.29.0/24
DATA_SUBNET=10.231.28.0/24
