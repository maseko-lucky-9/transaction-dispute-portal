#!/usr/bin/env bash
# Never commit secrets, a red build, red unit tests or a banned package. Steps skip until their target exists.
set -euo pipefail
if command -v gitleaks >/dev/null 2>&1; then gitleaks protect --staged --no-banner --redact; fi
if [ -f DisputePortal.slnx ]; then
  dotnet format whitespace DisputePortal.slnx --verify-no-changes
  dotnet build DisputePortal.slnx --nologo -v q
  [ -d backend/tests/DisputePortal.UnitTests ] && dotnet test backend/tests/DisputePortal.UnitTests --no-build --nologo -v q
fi
scripts/check-constraints.sh
if git diff --cached --name-only | grep -q '^frontend/' && [ -d frontend/node_modules ]; then
  npm --prefix frontend run lint && npm --prefix frontend run typecheck
fi
